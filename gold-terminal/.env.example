# ─── GOLD INTELLIGENCE TERMINAL V1 — environment ──────────────────────────────
# Copy to .env (Docker Compose) or apps/server/.env + export (local dev).
# All API keys stay on the server; the browser never receives them.

# live = Binance USDⓈ-M Futures XAUUSDT (public market data, no API key needed or used).
# fixture = replay fixture files, labelled NOT LIVE.
DATA_MODE=live

# ── Binance USDⓈ-M Futures (symbol is fixed to XAUUSDT) ──
BINANCE_REST_URL=https://fapi.binance.com
# Trades, mark price, 24h ticker and klines.
BINANCE_WS_MARKET_URL=wss://fstream.binance.com/market/stream
# bookTicker and depth. If book streams stay silent in your region, set this to the market URL.
BINANCE_WS_BOOK_URL=wss://fstream.binance.com/public/stream
# Share of the exchange's per-minute request weight (from exchangeInfo) this app may use.
BINANCE_WEIGHT_SAFETY=0.5
OPEN_INTEREST_POLL_SEC=15
CONTRACT_REFRESH_SEC=300
# REST last-price polling while the WebSocket is down (seconds, 0 = off).
PRICE_POLL_INTERVAL_SEC=5
HISTORY_BARS=1000
RECONCILE_DELAY_SEC=4
RECONCILE_INTERVAL_SEC=60
# Higher timeframes whose final stream kline is cross-checked over REST.
NATIVE_CONFIRM_TIMEFRAMES=5m,15m,1h,4h,1d
PRICE_DELAYED_AFTER_MS=5000
PRICE_STALE_AFTER_MS=30000

# ── Anthropic (Claude analyst) ──
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANALYST_EFFORT=medium
ANALYST_MAX_OUTPUT_TOKENS=12000
# Automatic analysis on BOS/CHoCH/trend change in ANALYST_TRIGGER_TIMEFRAMES.
ANALYST_AUTO_ENABLED=false
ANALYST_AUTO_COOLDOWN_SEC=900
ANALYST_MANUAL_COOLDOWN_SEC=60
ANALYST_MAX_CALLS_PER_DAY=40
ANALYST_MAX_USD_PER_DAY=5
ANALYST_INPUT_USD_PER_MTOK=4
ANALYST_OUTPUT_USD_PER_MTOK=20
ANALYST_TRIGGER_TIMEFRAMES=15m,1h,4h,1d
# Server-side refusal fallbacks (beta). Set false to disable.
ANALYST_USE_FALLBACKS=true
# Development only: allow sending fixture snapshots to Claude.
ANALYST_ALLOW_FIXTURE=false

# ── Admin access ──
# Bearer token required by every state-changing endpoint: alert rules, acks and the
# manual Claude refresh. Leave empty and those endpoints refuse every request.
# Generate with: openssl rand -hex 32   (min 32 characters)
ADMIN_API_TOKEN=

# ── Storage / HTTP ──
DATABASE_URL=postgres://gold:gold@localhost:5432/gold
PORT=4000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info

# ── Fixture mode ──
FIXTURE_DIR=../../fixtures/synthetic
FIXTURE_SPEED=1

# ── Web (build-time, public — not a secret) ──
NEXT_PUBLIC_API_BASE=http://localhost:4000
