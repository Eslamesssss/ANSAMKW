# ─── GOLD INTELLIGENCE TERMINAL V1 — environment ──────────────────────────────
# Copy to .env (Docker Compose) or apps/server/.env + export (local dev).
# All API keys stay on the server; the browser never receives them.

# live = Twelve Data (needs TWELVEDATA_API_KEY). fixture = replay fixture files, labelled NOT LIVE.
DATA_MODE=live
SYMBOL=XAU/USD

# ── Twelve Data ──
TWELVEDATA_API_KEY=
# Plan limits; the scheduler never exceeds them. Defaults = free Basic plan (8/min, 800/day).
# The free plan cannot confirm 1m candles every minute around the clock (1,440 credits/day).
# On it, set RECONCILE_INTERVAL_SEC=180 or higher, or use a paid plan.
TWELVEDATA_CREDITS_PER_MINUTE=8
TWELVEDATA_CREDITS_PER_DAY=800
# REST /price polling while the WebSocket is down (seconds, 0 = off). 1 credit per poll.
PRICE_POLL_INTERVAL_SEC=0
HISTORY_BARS=1000
RECONCILE_DELAY_SEC=4
RECONCILE_INTERVAL_SEC=60
# Timeframes whose native provider bar is fetched at each close; others are derived from confirmed 1m bars.
NATIVE_CONFIRM_TIMEFRAMES=1h,4h,1d
PRICE_DELAYED_AFTER_MS=15000
PRICE_STALE_AFTER_MS=60000

# ── Anthropic (Claude analyst) ──
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANALYST_EFFORT=medium
ANALYST_MAX_OUTPUT_TOKENS=12000
# Automatic analysis on BOS/CHoCH/trend change in ANALYST_TRIGGER_TIMEFRAMES.
ANALYST_AUTO_ENABLED=false
ANALYST_AUTO_COOLDOWN_SEC=900
ANALYST_MANUAL_COOLDOWN_SEC=60
ANALYST_MAX_CALLS_PER_DAY=40
ANALYST_MAX_USD_PER_DAY=5
ANALYST_INPUT_USD_PER_MTOK=4
ANALYST_OUTPUT_USD_PER_MTOK=20
ANALYST_TRIGGER_TIMEFRAMES=15m,1h,4h,1d
# Server-side refusal fallbacks (beta). Set false to disable.
ANALYST_USE_FALLBACKS=true
# Development only: allow sending fixture snapshots to Claude.
ANALYST_ALLOW_FIXTURE=false

# ── Storage / HTTP ──
DATABASE_URL=postgres://gold:gold@localhost:5432/gold
PORT=4000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info

# ── Fixture mode ──
FIXTURE_DIR=../../fixtures/synthetic
FIXTURE_SPEED=1

# ── Web (build-time, public — not a secret) ──
NEXT_PUBLIC_API_BASE=http://localhost:4000
